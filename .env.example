# ---------------------------------------------------------------------------
# Backend (backend/.env)
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/schdle-admin?retryWrites=true&w=majority

# Port the Express server listens on (optional, defaults to 5000)
PORT=5000

# ---------------------------------------------------------------------------
# Frontend (frontend/.env)
# ---------------------------------------------------------------------------

# Base URL of the backend API (no trailing slash)
# Local development example:
# REACT_APP_API_URL=http://localhost:5000
# Production example (Vercel):
# REACT_APP_API_URL=https://your-app.vercel.app
REACT_APP_API_URL=http://localhost:5000
